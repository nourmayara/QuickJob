generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  name String
  firstName String @default("")
  phone String @default("")
  role String @default("TRAVAILLEUR")
  suspended Boolean @default(false)
  sessions Session[]
  missions Mission[]
  applications Application[]
  city String?
  recruiterType String?
  companyName String?
  sector String?
  bio String?
  avatarUrl String?
  skills String?
  experience String?
  languages String?
  email String @unique
  password String
  createdAt DateTime @default(now())
  recruiterVerification RecruiterVerification? @relation("RecruiterVerificationOwner")
  recruiterDecisions RecruiterVerification[] @relation("RecruiterVerificationAdmin")
  notifications Notification[]
}

model RecruiterVerification {
  userId Int @id
  user User @relation("RecruiterVerificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  status String @default("EN_ATTENTE")
  requestedAt DateTime? @default(now())
  decidedAt DateTime?
  decidedById Int?
  decidedBy User? @relation("RecruiterVerificationAdmin", fields: [decidedById], references: [id], onDelete: SetNull)
  refusalReason String?
  legacy Boolean @default(false)
  notification Notification?
  @@index([status, requestedAt])
}

model Notification {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  message String
  createdAt DateTime @default(now())
  verificationId Int? @unique
  verification RecruiterVerification? @relation(fields: [verificationId], references: [userId], onDelete: Cascade)
  @@index([userId, createdAt])
}

model Session {
  id String @id
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([userId])
}
model Mission {
  id Int @id @default(autoincrement())
  title String
  description String
  status String @default("PUBLISHED")
  category String?
  city String?
  address String?
  date DateTime?
  startTime String?
  endTime String?
  pay Float?
  capacity Int @default(1)
  skills String?
  experience String?
  recruiterId Int
  recruiter User @relation(fields: [recruiterId], references: [id])
  applications Application[]
  createdAt DateTime @default(now())
  @@index([recruiterId])
}
model Application {
  id Int @id @default(autoincrement())
  missionId Int
  mission Mission @relation(fields: [missionId], references: [id])
  workerId Int
  worker User @relation(fields: [workerId], references: [id])
  status String @default("PENDING")
  message String?
  createdAt DateTime @default(now())
  @@unique([missionId, workerId])
  @@index([workerId])
}
